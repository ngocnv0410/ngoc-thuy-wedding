# Public Firebase Web app configuration (not a service-account key).
# These override src/content/firebase.ts when non-empty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional reCAPTCHA v3 site key for Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development only. Use a demo- project and local Firebase emulators.
VITE_FIREBASE_EMULATORS=false
