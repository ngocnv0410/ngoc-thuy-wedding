# Required key: GitHub repository Secret VITE_FIREBASE_API_KEY for deployment.
# For local development, copy to .env.local; never commit a real key.
# Vite embeds this Firebase Web key in browser JavaScript after the build.
VITE_FIREBASE_API_KEY=
# Optional overrides for public Firebase project identifiers.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional reCAPTCHA v3 site key for Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development only. Use a demo- project and local Firebase emulators.
VITE_FIREBASE_EMULATORS=false
