# Firebase Web config. Store in Cloudflare Workers > Settings > Build > Build variables and secrets.
# Vite embeds VITE_* values in browser JavaScript; these are not server-only secrets.
# For local development, copy this file to .env.local (ignored by Git).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional reCAPTCHA v3 site key for Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development only. Use a demo- project and local Firebase emulators.
VITE_FIREBASE_EMULATORS=false

# Optional canonical public URL for social previews, without a trailing slash.
# SITE_URL=https://ngoc-thuy-wedding.ngoc-nv0410.workers.dev
