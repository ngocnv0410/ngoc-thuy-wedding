rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /weddingWishes/{guestId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 50;

      // The document ID binds the only allowed create to the authenticated guest.
      allow create: if request.auth != null
        && request.auth.uid == guestId
        && request.resource.data.keys().hasAll(['name', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.name.matches('(?s).*[^\\s\\p{Z}\\p{Cf}].*')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 600
        && request.resource.data.message.matches('(?s).*[^\\s\\p{Z}\\p{Cf}].*')
        && request.resource.data.createdAt == request.time;

      // Moderation happens in the Firebase console, never with a browser admin key.
      allow update, delete: if false;
    }
  }
}
