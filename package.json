    "@react-three/fiber": "9.8.2",
    "firebase": "13.1.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "photoswipe": "5.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "1.3.10",
    "@types/pngjs": "6.0.5",
