  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/generate-qr.ts && node scripts/generate-og.ts",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
